{"version":"1.0","encoding":"UTF-8","feed":{"xmlns":"http://www.w3.org/2005/Atom","xmlns$openSearch":"http://a9.com/-/spec/opensearchrss/1.0/","xmlns$blogger":"http://schemas.google.com/blogger/2008","xmlns$georss":"http://www.georss.org/georss","xmlns$gd":"http://schemas.google.com/g/2005","xmlns$thr":"http://purl.org/syndication/thread/1.0","id":{"$t":"tag:blogger.com,1999:blog-1701841060652880055"},"updated":{"$t":"2026-09-17T01:19:30.901-07:00"},"category":[{"term":"Series"},{"term":"Org"},{"term":"Completed"},{"term":"New"},{"term":"API"},{"term":"Ep 12"},{"term":"T"},{"term":"FanDub"},{"term":"Ongoing"},{"term":"Movie"},{"term":"D"},{"term":"Ep 13"},{"term":"M"},{"term":"Ep 01"},{"term":"N"},{"term":"Ep 24"},{"term":"A"},{"term":"B"},{"term":"S"},{"term":"Ep 25"},{"term":"R"},{"term":"I"},{"term":"Updated"},{"term":"C"},{"term":"Ep 26"},{"term":"Ep 08"},{"term":"H"},{"term":"O"},{"term":"F"},{"term":"G"},{"term":"W"},{"term":"EngDub"},{"term":"Ep 02"},{"term":"Ep 03"},{"term":"Exclusive"},{"term":"L"},{"term":"V"},{"term":"P"},{"term":"EngSub"},{"term":"Ep 04"},{"term":"Ep 05"},{"term":"Ep 10"},{"term":"Ep 15"},{"term":"Ep 27"},{"term":"K"},{"term":"Ep 14"},{"term":"Ep 21"},{"term":"J"},{"term":"Ep 000"},{"term":"Ep 11"},{"term":"Ep 16"},{"term":"Ep 18"},{"term":"Ep 22"},{"term":"Ep 23"},{"term":"Ep 48"},{"term":"HindiSub"},{"term":"Y"},{"term":"#"},{"term":"Ep 17"},{"term":"Ep 19"},{"term":"Ep 20"},{"term":"Ep 28"},{"term":"Ep 29"},{"term":"Ep 52"},{"term":"Z"},{"term":"E"},{"term":"Ep 09"},{"term":"Ep 30"},{"term":"Ep 31"},{"term":"Ep 32"},{"term":"Ep 35"},{"term":"Ep 36"},{"term":"Ep 37"},{"term":"Ep 45"},{"term":"Ep 51"},{"term":"Ep 55"},{"term":"Ep 61"},{"term":"Ogoing"}],"title":{"type":"text","$t":"Sub Dub Anime - Watch Hindi \u0026amp; English Dubbed and Subbed Anime Online Free"},"subtitle":{"type":"html","$t":"Sub Dub Anime - Watch and download Hindi Dubbed, Fan Dubbed, English Subbed, English Dubbed, and Hindi Subbed anime in HD. Enjoy free streaming in 480p, 720p, and 1080p BluRay!"},"link":[{"rel":"http://schemas.google.com/g/2005#feed","type":"application/atom+xml","href":"https:\/\/www.subdubanime.site\/feeds\/posts\/default"},{"rel":"self","type":"application/atom+xml","href":"https:\/\/www.blogger.com\/feeds\/1701841060652880055\/posts\/default?alt=json\u0026max-results=3"},{"rel":"alternate","type":"text/html","href":"https:\/\/www.subdubanime.site\/"},{"rel":"hub","href":"http://pubsubhubbub.appspot.com/"},{"rel":"next","type":"application/atom+xml","href":"https:\/\/www.blogger.com\/feeds\/1701841060652880055\/posts\/default?alt=json\u0026start-index=4\u0026max-results=3"}],"author":[{"name":{"$t":"Robin"},"uri":{"$t":"http:\/\/www.blogger.com\/profile\/13102002283066734135"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"32","height":"32","src":"\/\/blogger.googleusercontent.com\/img\/b\/R29vZ2xl\/AVvXsEjtDqUqWZFVCFVI6qh4AnNJoq1ilP7zFFYwbDrz4gwWaxRp1qvyKUFtQbjwZTAa8-tAxEs1NSlw90lo_xV8Xp81Yf26gj1PdUWRJPWPGDVBer6POs40SSXILZtk_VeCyWVxjfsa91rQruow4a4cUypcaFWbsfwArs0xysQN5OlM8P5S\/s220\/342062.jpeg"}}],"generator":{"version":"7.00","uri":"http://www.blogger.com","$t":"Blogger"},"openSearch$totalResults":{"$t":"358"},"openSearch$startIndex":{"$t":"1"},"openSearch$itemsPerPage":{"$t":"3"},"entry":[{"id":{"$t":"tag:blogger.com,1999:blog-1701841060652880055.post-2343231537793169737"},"published":{"$t":"2026-09-01T11:37:49.160-07:00"},"updated":{"$t":"2026-09-17T01:19:30.901-07:00"},"title":{"type":"text","$t":"Streaming"},"content":{"type":"html","$t":"\u003Cdiv id=\"dynamic-stream-area\" style=\"align-items: center; color: #bf953f; display: flex; flex-direction: column; justify-content: center; min-height: 500px;\"\u003E\n  \u003Cdiv class=\"golden-spinner\"\u003E\u003C\/div\u003E\n  \u003Cdiv id=\"loading-text\" style=\"animation: 1.5s ease 0s infinite normal none running pulse; color: #fcf6ba; font-size: 1.1rem; font-weight: bold; letter-spacing: 1px; margin-top: 20px; text-shadow: rgb(191, 149, 63) 0px 0px 10px;\"\u003ECONNECTING...\u003C\/div\u003E\n\u003C\/div\u003E\n\n\u003Cstyle\u003E\n\/* --- UNIVERSAL BOX-SIZING (Must be first) --- *\/\n*, *::before, *::after {\n    box-sizing: border-box;\n}\n\n\/* --- SPINNER \u0026 THEME --- *\/\n.golden-spinner { position: relative; width: 70px; height: 70px; }\n.golden-spinner::before { content: \"\"; position: absolute; top: 5px; left: 5px; right: 5px; bottom: 5px; border-radius: 50%; border: 3px solid transparent; border-top-color: #BF953F; border-bottom-color: #BF953F; animation: spin-right 1.5s linear infinite; box-shadow: 0 0 15px rgba(191,149,63,0.3); }\n.golden-spinner::after { content: \"\"; position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 50%; border: 3px solid transparent; border-left-color: #FCF6BA; border-right-color: #B38728; animation: spin-left 2.5s linear infinite; box-shadow: 0 0 15px rgba(191,149,63,0.3); }\n@keyframes spin-right { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }\n@keyframes spin-left { 0% { transform: rotate(0deg); } 100% { transform: rotate(-360deg); } }\n@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }\n\n\/* --- CRITICAL: CONTAINER WIDTH FIX --- *\/\n#dynamic-stream-area { \n    width: 100%;\n    max-width: 100%;\n    overflow-x: hidden; \/* Prevents horizontal scroll *\/\n    position: relative;\n    display: block;\n    padding: 0; \/* Remove any default padding *\/\n    margin: 0; \/* Remove any default margin *\/\n}\n\n\/* --- LUXURY PLAYER STYLES (FIXED WIDTH CALCULATION) --- *\/\n.player-wrapper2 {\n    width: 100%;\n    max-width: 100%;\n    margin: 0 auto;\n    padding: 1rem;\n    position: relative;\n    z-index: 1;\n    overflow: hidden;\n}\n\n\/* For desktop with sidebar - reduce max-width *\/\n@media (min-width: 1200px) {\n    .player-wrapper2 {\n        max-width: calc(100vw - 350px); \/* Adjust 350px based on your sidebar width *\/\n    }\n}\n\n.player-container2 {\n    position: relative;\n    width: 100%;\n    padding-bottom: 56.25%; \/* 16:9 aspect ratio *\/\n    height: 0;\n    overflow: hidden;\n    background: linear-gradient(135deg, rgba(10,10,31,.95), rgba(20,15,35,.92));\n    border-radius: 16px;\n    box-shadow: 0 20px 50px rgba(0,0,0,.5), 0 0 0 1px rgba(191,149,63,.4);\n    border: 1.5px solid rgba(191,149,63,.5);\n    margin-bottom: 1rem;\n}\n\n.player-container2 iframe {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    border: none;\n    border-radius: 16px;\n}\n\n\/* --- TEXT \u0026 INFO --- *\/\n.current-episode2 {\n    font-size: 1.1rem;\n    font-weight: 700;\n    color: #FCF6BA;\n    text-align: center;\n    padding: 12px 16px;\n    background: linear-gradient(135deg, rgba(10,10,31,.98), rgba(20,15,35,.98));\n    border-radius: 12px;\n    border: 1px solid rgba(191,149,63,.5);\n    box-shadow: 0 8px 20px rgba(0,0,0,.3);\n    margin: 0 0 12px 0;\n    width: 100%;\n}\n\n.current-episode2 span {\n    background: linear-gradient(90deg, #BF953F 0%, #FCF6BA 50%, #B38728 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    font-weight: 800;\n}\n\n\/* --- CONTROLS AREA (Prevents overflow) --- *\/\n.controls-area {\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n}\n\n\/* --- GOLDEN BUTTONS (Action Buttons - Optimized for Performance) --- *\/\n.action-buttons2 {\n    display: flex;\n    justify-content: space-between;\n    gap: 12px;\n    flex-wrap: wrap;\n    width: 100%;\n}\n\n.action-button2 {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 12px 20px;\n    border-radius: 50px;\n    text-decoration: none;\n    font-weight: 700;\n    \/* Performance Fix: Replaced 'all' with specific hardware-accelerated properties *\/\n    transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;\n    color: #BF953F;\n    cursor: pointer;\n    font-size: .9rem;\n    background: rgba(20, 20, 35, 0.8);\n    border: 1px solid rgba(191,149,63,0.5);\n    flex: 1 1 calc(50% - 6px); \/* Responsive flex basis *\/\n    min-width: 120px;\n    text-transform: uppercase;\n    letter-spacing: .5px;\n    position: relative;\n    overflow: hidden;\n    will-change: transform;\n}\n\n\/* New Clean Hover Effect - Keeps dark aesthetic, boosts performance *\/\n.action-button2:hover {\n    background: rgba(30, 30, 45, 0.95); \/* Slightly lighter dark, no heavy gradient *\/\n    color: #FCF6BA; \/* Brighten text *\/\n    border-color: #FCF6BA; \/* Brighten border *\/\n    box-shadow: 0 4px 15px rgba(191, 149, 63, 0.2); \/* Softer, performant shadow *\/\n    transform: translateY(-2px);\n}\n\n.action-button2 svg {\n    stroke: #BF953F;\n    transition: stroke 0.25s ease, filter 0.25s ease;\n    flex-shrink: 0;\n}\n\n.action-button2:hover svg {\n    stroke: #FCF6BA; \/* Match bright text *\/\n    filter: drop-shadow(0 0 3px rgba(252, 246, 186, 0.4));\n}\n\n\/* --- EPISODE CONTAINER --- *\/\n.episode-buttons-container2 {\n    width: 100%;\n    max-width: 100%;\n    background: linear-gradient(135deg, rgba(10,10,31,.95), rgba(20,15,35,.95));\n    border-radius: 16px;\n    padding: 1.2rem;\n    margin-top: .5rem;\n    border: 1px solid rgba(191,149,63,.4);\n    box-shadow: 0 20px 50px rgba(0,0,0,.5);\n    overflow: hidden;\n}\n\n.episodes-title2 {\n    font-size: 1.1rem;\n    font-weight: 700;\n    margin-bottom: 1rem;\n    color: #FCF6BA;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n\n.episodes-title2 svg {\n    stroke: #BF953F;\n    filter: drop-shadow(0 0 5px rgba(191,149,63,0.5));\n    flex-shrink: 0;\n}\n\n\/* --- GOLDEN EPISODE BUTTONS --- *\/\n.episode-buttons2 {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(55px, 1fr));\n    gap: 10px;\n    width: 100%;\n}\n\n.episode-button2 {\n    background: rgba(191, 149, 63, 0.1);\n    color: #BF953F;\n    border: 1px solid rgba(191,149,63,0.4);\n    padding: 12px;\n    border-radius: 10px;\n    cursor: pointer;\n    \/* Performance Fix *\/\n    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;\n    font-size: .95rem;\n    font-weight: 700;\n    text-align: center;\n    position: relative;\n    text-decoration: none;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    will-change: transform;\n}\n\n.episode-button2:hover {\n    border-color: #FCF6BA;\n    color: #FCF6BA;\n    box-shadow: 0 0 10px rgba(191,149,63,0.3);\n    transform: translateY(-2px);\n    background: rgba(191, 149, 63, 0.2);\n}\n\n.episode-button2.active2 {\n    background: linear-gradient(135deg, #B38728 0%, #FCF6BA 50%, #BF953F 100%);\n    color: #000;\n    border-color: #FCF6BA;\n    box-shadow: 0 0 15px rgba(191,149,63,0.4);\n    transform: scale(1.05);\n    font-weight: 800;\n}\n\n\/* --- GOLDEN SEASON SELECTOR --- *\/\n.season-scroller-box {\n    margin-bottom: 20px;\n    padding-bottom: 15px;\n    border-bottom: 1px solid rgba(191,149,63,0.3);\n    width: 100%;\n    overflow: hidden;\n}\n\n.season-label {\n    font-size: 0.85rem;\n    color: #FCF6BA;\n    font-weight: 700;\n    margin-bottom: 10px;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    display: block;\n    text-shadow: 0 0 5px #BF953F;\n}\n\n.seasons-list {\n    display: flex;\n    gap: 10px;\n    overflow-x: auto;\n    padding-bottom: 5px;\n    scrollbar-width: thin;\n    scrollbar-color: #BF953F #1a1a2e;\n    width: 100%;\n}\n\n.seasons-list::-webkit-scrollbar {\n    height: 4px;\n}\n\n.seasons-list::-webkit-scrollbar-track {\n    background: #1a1a2e;\n    border-radius: 4px;\n}\n\n.seasons-list::-webkit-scrollbar-thumb {\n    background: #BF953F;\n    border-radius: 4px;\n}\n\n.season-btn {\n    white-space: nowrap;\n    padding: 8px 18px;\n    border-radius: 20px;\n    background: rgba(191, 149, 63, 0.1);\n    border: 1px solid rgba(191,149,63,0.5);\n    color: #BF953F;\n    font-size: 0.9rem;\n    font-weight: 600;\n    text-decoration: none;\n    \/* Performance Fix *\/\n    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;\n    flex-shrink: 0;\n}\n\n.season-btn:hover {\n    background: rgba(191,149,63,0.3);\n    color: #FCF6BA;\n    border-color: #FCF6BA;\n    box-shadow: 0 0 8px rgba(191,149,63,0.3);\n}\n\n.season-btn.active-season {\n    background: linear-gradient(135deg, #B38728 0%, #FCF6BA 50%, #BF953F 100%);\n    color: #000;\n    font-weight: 800;\n    border-color: #FCF6BA;\n    box-shadow: 0 0 15px rgba(191,149,63,0.4);\n}\n\n\/* --- RESPONSIVE FIXES --- *\/\n@media(max-width: 768px) {\n    .player-wrapper2 {\n        padding: 0.5rem;\n        max-width: 100%;\n    }\n    .action-button2 {\n        font-size: .85rem;\n        padding: 10px 16px;\n    }\n    .current-episode2 {\n        font-size: 1rem;\n        padding: 10px 14px;\n    }\n}\n\n@media(max-width: 500px) {\n    .episode-buttons2 {\n        grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));\n        gap: 5px;\n    }\n    .episode-button2 {\n        padding: 8px 2px;\n        font-size: 0.85rem;\n    }\n    .player-wrapper2 {\n        padding: 0.25rem;\n    }\n}\n\u003C\/style\u003E\n\n\u003Cscript\u003E\n\/\/\u003C![CDATA[\n(function() {\n    \/\/ API config aur SERVER_URL ab BLAKITE_CFG se aayega\n    let p_id='', p_season='', p_totalEps=0, p_currentEp=1, p_isMovie=false, p_seasonList=[];\n    let p_title='', p_img='';\n \n    async function initPlayerSystem() {\n        const params = new URLSearchParams(window.location.search);\n        const urlId   = params.get('id');\n        const type    = params.get('type');\n        const season  = params.get('s');\n        const epParam = params.get('episode');\n        if(epParam) p_currentEp = parseInt(epParam);\n \n        if(!urlId || !type) {\n            const container = document.getElementById('dynamic-stream-area');\n            if(container) container.innerHTML = \"\u003Ch3 style='color:#fff; text-align:center; padding:20px;'\u003EPlease select content from Home.\u003C\/h3\u003E\";\n            return;\n        }\n \n        \/\/ Seedha Global API se data fetch\n        const rawData = await BlakiteAPI.getData();\n \n        if(rawData) {\n            processAndInject(rawData, urlId, type, season);\n        } else {\n            const container = document.getElementById('dynamic-stream-area');\n            if(container) container.innerHTML = \"\u003Ch3 style='color:#fff; text-align:center; padding:20px;'\u003EFailed to load stream data.\u003C\/h3\u003E\";\n        }\n    }\n \n    function processAndInject(data, id, type, season) {\n        let animeItem  = null;\n        let displayTitle = \"Unknown\";\n        let displayDesc  = \"\";\n        \/\/ Global Default image fallback\n        let displayImg   = BLAKITE_CFG.defaultImg || \"https:\/\/blogger.googleusercontent.com\/img\/b\/R29vZ2xl\/AVvXsEg\/s1600\/default.jpg\";\n \n        if(data) {\n            if(type === 'Movie'  \u0026\u0026 data.movies \u0026\u0026 data.movies[id])  animeItem = data.movies[id];\n            else if(type === 'Series' \u0026\u0026 data.series \u0026\u0026 data.series[id]) animeItem = data.series[id];\n            else if(type === 'Drama'  \u0026\u0026 data.dramas \u0026\u0026 data.dramas[id]) animeItem = data.dramas[id];\n        }\n \n        p_id       = id;\n        p_season   = season || \"1\";\n        p_isMovie  = (type === 'Movie');\n        p_seasonList = [];\n        p_totalEps   = 0;\n \n        if(animeItem) {\n            \/\/ SEO update\n            if(typeof updateGlobalSEO === 'function') {\n                updateGlobalSEO(animeItem, type, p_season, p_currentEp);\n            }\n \n            displayTitle = animeItem.title || \"Unknown\";\n \n            \/\/ IMAGES null safe with default fallback\n            if(animeItem.IMAGES) {\n                displayImg = animeItem.IMAGES.poster || animeItem.IMAGES.backdrop || displayImg;\n            }\n \n            \/\/ Description\n            if(animeItem.TMDB_DATA \u0026\u0026 animeItem.TMDB_DATA.synopsis \u0026\u0026 animeItem.TMDB_DATA.synopsis.length \u003E 5) {\n                displayDesc = animeItem.TMDB_DATA.synopsis;\n            } else if(animeItem.TMDB_DATA \u0026\u0026 animeItem.TMDB_DATA.overview \u0026\u0026 animeItem.TMDB_DATA.overview.length \u003E 5) {\n                displayDesc = animeItem.TMDB_DATA.overview;\n            }\n \n            if(!p_isMovie \u0026\u0026 animeItem.seasons) {\n                p_seasonList = Object.keys(animeItem.seasons).sort((a, b) =\u003E Number(a) - Number(b));\n \n                \/\/ Agar URL mein di gayi season exist nahi karti to pehli season lo\n                if(!animeItem.seasons[p_season] \u0026\u0026 p_seasonList.length \u003E 0) {\n                    p_season = p_seasonList[0];\n                }\n \n                \/\/ FIX: episodes object nahi hai ab, totalEpisodes use karo\n                if(animeItem.seasons[p_season]) {\n                    p_totalEps = animeItem.seasons[p_season].totalEpisodes || 0;\n                }\n            } else if(p_isMovie) {\n                p_totalEps = 1;\n            }\n \n            if(!p_isMovie \u0026\u0026 !displayTitle.toLowerCase().includes('season') \u0026\u0026 p_season) {\n                displayTitle += ` Season ${p_season}`;\n            }\n        }\n \n        p_title = displayTitle;\n        p_img   = displayImg;\n        document.title = \"Watch: \" + displayTitle;\n \n        const container = document.getElementById('dynamic-stream-area');\n        if(!container) return;\n        container.removeAttribute('style');\n        renderPlayerUI(container);\n        loadStream();\n \n        const breadcrumbTitle = document.querySelector('.breadcrumb strong');\n        if(breadcrumbTitle) breadcrumbTitle.innerText = displayTitle;\n \n        const infoTitle = document.querySelector('#info .info .title');\n        if(infoTitle) infoTitle.innerText = displayTitle;\n    }\n \n    function renderPlayerUI(container) {\n        let seasonsHTML = '';\n        if(!p_isMovie \u0026\u0026 p_seasonList.length \u003E 1) {\n            let btns = '';\n            p_seasonList.forEach(s =\u003E {\n                const url = new URL(window.location.href);\n                url.searchParams.set(\"s\", s);\n                url.searchParams.set(\"episode\", 1);\n                const activeClass = (s == p_season) ? \"active-season\" : \"\";\n                btns += `\u003Ca href=\"${url.toString()}\" class=\"season-btn ${activeClass}\"\u003ESeason ${s}\u003C\/a\u003E`;\n            });\n            seasonsHTML = `\u003Cdiv class=\"season-scroller-box\"\u003E\u003Cspan class=\"season-label\"\u003ESelect Season\u003C\/span\u003E\u003Cdiv class=\"seasons-list\"\u003E${btns}\u003C\/div\u003E\u003C\/div\u003E`;\n        }\n \n        let epHTML = '';\n        if(!p_isMovie \u0026\u0026 p_totalEps \u003E 0) {\n            for(let i = 1; i \u003C= p_totalEps; i++) {\n                const url = new URL(window.location.href);\n                url.searchParams.set(\"episode\", i);\n                const active = (i === p_currentEp) ? \"active2\" : \"\";\n                epHTML += `\u003Ca href=\"${url.toString()}\" class=\"episode-button2 ${active}\"\u003E${i}\u003C\/a\u003E`;\n            }\n        }\n \n        container.innerHTML = `\n        \u003Cdiv class=\"player-wrapper2\"\u003E\n            \u003Cdiv class=\"player-container2\"\u003E\n                \u003Ciframe id=\"mainIframe\" allowfullscreen scrolling=\"no\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;\"\u003E\u003C\/iframe\u003E\n            \u003C\/div\u003E\n            \u003Cdiv class=\"controls-area\"\u003E\n                \u003Cdiv class=\"current-episode2\"\u003E\n                    \u003Cp\u003EPlaying: \u003Cspan\u003E${p_isMovie ? \"Full Movie\" : `Season ${p_season} - Episode ${p_currentEp}`}\u003C\/span\u003E\u003C\/p\u003E\n                \u003C\/div\u003E\n                \u003Cdiv class=\"action-buttons2\"\u003E\n                    \u003Ca href=\"https:\/\/t.me\/subdubanime1\" target=\"_blank\" class=\"action-button2\" style=\"text-decoration: none; color: inherit;\"\u003E\n                        \u003Csvg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003E\n                            \u003Cline x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"\u003E\u003C\/line\u003E\n                            \u003Cpolygon points=\"22 2 15 22 11 13 2 9 22 2\"\u003E\u003C\/polygon\u003E\n                        \u003C\/svg\u003E Join Telegram\n                    \u003C\/a\u003E\n                    \u003Cbutton class=\"action-button2\" onclick=\"openDownload()\"\u003E\n                        \u003Csvg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003E\n                            \u003Cpath d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"\u003E\u003C\/path\u003E\n                            \u003Cpolyline points=\"7 10 12 15 17 10\"\u003E\u003C\/polyline\u003E\n                            \u003Cline x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"\u003E\u003C\/line\u003E\n                        \u003C\/svg\u003E Download\n                    \u003C\/button\u003E\n                \u003C\/div\u003E\n            \u003C\/div\u003E\n            ${(!p_isMovie \u0026\u0026 p_totalEps \u003E 0) ? `\n            \u003Cdiv class=\"episode-buttons-container2\"\u003E\n                ${seasonsHTML}\n                \u003Cdiv class=\"episodes-title2\"\u003E\n                    \u003Csvg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003E\n                        \u003Crect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" ry=\"2\"\u003E\u003C\/rect\u003E\n                        \u003Cline x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"\u003E\u003C\/line\u003E\n                        \u003Cline x1=\"12\" x2=\"12\" y1=\"8\" y2=\"16\"\u003E\u003C\/line\u003E\n                    \u003C\/svg\u003E Episodes\n                \u003C\/div\u003E\n                \u003Cdiv class=\"episode-buttons2\"\u003E${epHTML}\u003C\/div\u003E\n            \u003C\/div\u003E` : \"\"}\n        \u003C\/div\u003E`;\n    }\n \n    function loadStream() {\n        const iframe = document.getElementById(\"mainIframe\");\n        if(!iframe) return;\n \n        \/\/ BLAKITE_CFG.serverUrl use kiya gaya hai embed link ke liye\n        const src = p_isMovie\n            ? `${BLAKITE_CFG.serverUrl}embed\/${p_id}`\n            : `${BLAKITE_CFG.serverUrl}embed\/${p_id}\/${p_season}-${p_currentEp}`;\n        iframe.src = src;\n \n        \/\/ History save\n        let history = JSON.parse(localStorage.getItem('blakite_history') || '[]');\n        history = history.filter(h =\u003E h.id !== p_id);\n        history.unshift({\n            id:           p_id,\n            title:        p_title,\n            img:          p_img,\n            link:         window.location.href,\n            progressText: p_isMovie ? 'Movie' : `S${p_season}-E${p_currentEp}`,\n            timestamp:    Date.now()\n        });\n        if(history.length \u003E 10) history.pop();\n        localStorage.setItem('blakite_history', JSON.stringify(history));\n    }\n \n    window.openDownload = function() {\n        \/\/ BLAKITE_CFG.serverUrl use kiya gaya hai download link ke liye\n        const url = p_isMovie\n            ? `${BLAKITE_CFG.serverUrl}download\/${p_id}`\n            : `${BLAKITE_CFG.serverUrl}download\/${p_id}\/${p_season}-${p_currentEp}`;\n        window.open(url, \"_blank\");\n    };\n \n    \/\/ DOMContentLoaded se safe execution\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', initPlayerSystem);\n    } else {\n        initPlayerSystem();\n    }\n})();\n\/\/]]\u003E\n\u003C\/script\u003E"},"link":[{"rel":"edit","type":"application/atom+xml","href":"https:\/\/www.blogger.com\/feeds\/1701841060652880055\/posts\/default\/2343231537793169737"},{"rel":"self","type":"application/atom+xml","href":"https:\/\/www.blogger.com\/feeds\/1701841060652880055\/posts\/default\/2343231537793169737"},{"rel":"alternate","type":"text/html","href":"https:\/\/www.subdubanime.site\/2026\/09\/streaming.html","title":"Streaming"}],"author":[{"name":{"$t":"Robin"},"uri":{"$t":"http:\/\/www.blogger.com\/profile\/13102002283066734135"},"email":{"$t":"noreply@blogger.com"},"gd$image":{"rel":"http://schemas.google.com/g/2005#thumbnail","width":"32","height":"32","src":"\/\/blogger.googleusercontent.com\/img\/b\/R29vZ2xl\/AVvXsEjtDqUqWZFVCFVI6qh4AnNJoq1ilP7zFFYwbDrz4gwWaxRp1qvyKUFtQbjwZTAa8-tAxEs1NSlw90lo_xV8Xp81Yf26gj1PdUWRJPWPGDVBer6POs40SSXILZtk_VeCyWVxjfsa91rQruow4a4cUypcaFWbsfwArs0xysQN5OlM8P5S\/s220\/342062.jpeg"}}]},{"id":{"$t":"tag:blogger.com,1999:blog-1701841060652880055.post-5362222290657361255"},"published":{"$t":"2025-08-02T08:12:00.000-07:00"},"updated":{"$t":"2025-08-02T21:03:49.196-07:00"},"category":[{"scheme":"http://www.blogger.com/atom/ns#","term":"Ep 03"},{"scheme":"http://www.blogger.com/atom/ns#","term":"K"},{"scheme":"http://www.blogger.com/atom/ns#","term":"New"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Ongoing"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Org"},{"scheme":"http://www.blogger.com/atom/ns#","term":"Series"}],"title":{"type":"text","$t":"Kaiju no 8 Season 2 (Hindi)"},"content":{"type":"html","$t":"\u003C!--[ Player Code (Don't Touch) ]--\u003E\n\u003Cdiv id=\"videoPlayerContainer2\"\u003E\u